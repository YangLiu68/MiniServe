# Copy to .env and adjust. Every setting is optional; defaults shown.
# Never commit .env (it is git-ignored).

# --- backend / model ---
# hf   = Hugging Face Transformers model (downloads weights on first start)
# toy  = deterministic echo model, no torch, simulated latency (tests, scheduling experiments)
# tiny = 2-layer random GPT-2, no download (exercises the torch path; output is gibberish)
MINISERVE_BACKEND=hf
MINISERVE_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
MINISERVE_MODEL_REVISION=12fd25f77366fa6b3b4b768ec3050bf629380bac
MINISERVE_DEVICE=auto          # auto | cpu | mps | cuda
MINISERVE_DTYPE=auto           # auto | float32 | float16 | bfloat16
MINISERVE_WARMUP=true

# --- toy backend simulated cost ---
MINISERVE_TOY_PREFILL_MS_PER_TOKEN=0
MINISERVE_TOY_DECODE_MS_PER_TOKEN=0

# --- network / safety ---
MINISERVE_HOST=127.0.0.1       # non-loopback hosts require MINISERVE_API_KEY
MINISERVE_PORT=8000
MINISERVE_API_KEY=             # set to require "Authorization: Bearer <key>"
MINISERVE_ALLOW_UNAUTHENTICATED_PUBLIC=false
MINISERVE_RATE_LIMIT_RPM=120   # per client IP, token bucket; 0 disables
MINISERVE_RATE_LIMIT_BURST=20

# --- request limits ---
MINISERVE_MAX_PROMPT_CHARS=32768
MINISERVE_MAX_PROMPT_TOKENS=2048
MINISERVE_MAX_NEW_TOKENS_CAP=512
MINISERVE_DEFAULT_MAX_TOKENS=128
MINISERVE_REQUEST_TIMEOUT_S=60
MINISERVE_MAX_PENDING=8        # waiting requests beyond the one running; overflow -> 503

MINISERVE_LOG_LEVEL=info
# HF_TOKEN=                    # only needed for gated models; not needed for the default
