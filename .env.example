# MiniServe configuration. Copy to .env (git-ignored) and adjust; every setting is optional.
# Defaults shown. Generated from miniserve.config.Settings.

# --- Backend / model ---
MINISERVE_BACKEND=native                         # native (our paged-KV engine) | hf (Transformers baseline) | toy (echo, no torch) | tiny (random 2-layer Llama)
MINISERVE_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
MINISERVE_MODEL_REVISION=12fd25f77366fa6b3b4b768ec3050bf629380bac
MINISERVE_DEVICE=auto                            # auto | cpu | mps | cuda
MINISERVE_DTYPE=auto                             # auto | float32 | float16 | bfloat16
MINISERVE_MAX_MODEL_LEN=4096
MINISERVE_QUANTIZATION=none                      # none | int8 (weight-only, native backend)
MINISERVE_WARMUP=true
MINISERVE_TORCH_THREADS=

# --- KV cache + scheduler ---
MINISERVE_KV_CACHE_MB=256.0                      # paged KV cache size (native/hf accounting)
MINISERVE_BLOCK_SIZE=16
MINISERVE_MAX_NUM_SEQS=32
MINISERVE_MAX_NUM_BATCHED_TOKENS=512             # per-step token budget = prefill chunk size
MINISERVE_ENABLE_CHUNKED_PREFILL=true
MINISERVE_ENABLE_PREFIX_CACHING=true
MINISERVE_PREFIX_CACHE_SCOPE=global              # global | tenant (no cross-tenant cache sharing)
MINISERVE_SCHEDULING_POLICY=fcfs                 # fcfs | fair (Virtual Token Counter per tenant)

# --- Speculative decoding (n-gram / prompt-lookup drafts; native and toy backends) ---
MINISERVE_SPECULATIVE=none                       # none | ngram
MINISERVE_NUM_SPECULATIVE_TOKENS=4               # draft tokens verified per step
MINISERVE_SPEC_NGRAM_MAX=3                       # longest n-gram matched against the context
MINISERVE_SPEC_NGRAM_MIN=2
MINISERVE_SPEC_MAX_BATCH=4                       # speculate only while <= this many seqs decode

# --- Admission control / backpressure ---
MINISERVE_MAX_WAITING=256                        # requests allowed to wait beyond the running batch
MINISERVE_MAX_WAITING_PER_TENANT=64
MINISERVE_MAX_QUEUED_TOKENS=262144

# --- Toy backend (simulated step cost) ---
MINISERVE_TOY_PREFILL_MS_PER_TOKEN=0.0
MINISERVE_TOY_DECODE_MS_PER_TOKEN=0.0
MINISERVE_TOY_STEP_OVERHEAD_MS=0.0
MINISERVE_TOY_KV_BLOCKS=8192

# --- Network / safety ---
MINISERVE_HOST=127.0.0.1                         # non-loopback hosts require an API key
MINISERVE_PORT=8000
MINISERVE_API_KEY=                               # single key -> tenant 'default'
MINISERVE_API_KEYS=                              # multi-tenant: tenant:key,tenant2:key2
MINISERVE_ALLOW_UNAUTHENTICATED_PUBLIC=false
MINISERVE_RATE_LIMIT_RPM=600.0                   # per tenant; 0 disables
MINISERVE_RATE_LIMIT_BURST=60
MINISERVE_MAX_REQUEST_BYTES=1048576              # request body limit (413)

# --- Request limits ---
MINISERVE_MAX_PROMPT_CHARS=65536
MINISERVE_MAX_PROMPT_TOKENS=4096
MINISERVE_MAX_NEW_TOKENS_CAP=1024
MINISERVE_DEFAULT_MAX_TOKENS=128
MINISERVE_REQUEST_TIMEOUT_S=120.0

# --- Ops ---
MINISERVE_LOG_LEVEL=info
MINISERVE_LOG_FORMAT=text                        # text | json
MINISERVE_DRAIN_TIMEOUT_S=30.0

# HF_TOKEN=                                   # only for gated models; not needed for the default
