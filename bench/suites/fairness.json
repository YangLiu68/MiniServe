{
  "name": "fairness",
  "tokenizer": "hf:HuggingFaceTB/SmolLM2-135M-Instruct@12fd25f77366fa6b3b4b768ec3050bf629380bac",
  "rounds": 2,
  "port": 8100,
  "description": "M2 - fairness under contention. Capacity is limited to 4 running sequences; tenant 'heavy' keeps 12 requests in flight, tenant 'light' keeps 1 (64->64 tokens each). FCFS serves in arrival order; fair = Virtual Token Counter (Sheng et al., OSDI'24).",
  "configs": [
    {
      "name": "fcfs",
      "env": {
        "MINISERVE_SCHEDULING_POLICY": "fcfs"
      }
    },
    {
      "name": "fair-vtc",
      "env": {
        "MINISERVE_SCHEDULING_POLICY": "fair"
      }
    }
  ],
  "base_env": {
    "MINISERVE_DEVICE": "mps",
    "MINISERVE_DTYPE": "float16",
    "MINISERVE_KV_CACHE_MB": "512",
    "MINISERVE_REQUEST_TIMEOUT_S": "900",
    "MINISERVE_MAX_WAITING": "1024",
    "MINISERVE_MAX_WAITING_PER_TENANT": "1024",
    "PYTORCH_MPS_HIGH_WATERMARK_RATIO": "0.5",
    "PYTORCH_MPS_LOW_WATERMARK_RATIO": "0.4",
    "MINISERVE_BACKEND": "native",
    "MINISERVE_MAX_NUM_SEQS": "4",
    "MINISERVE_API_KEYS": "heavy:bench-heavy,light:bench-light"
  },
  "scenarios": [
    {
      "name": "heavy-vs-light",
      "seed": 4,
      "streams": [
        {
          "tenant": "heavy",
          "api_key": "bench-heavy",
          "mode": "closed",
          "concurrency": 12,
          "duration_s": 60,
          "prompt_tokens": 64,
          "max_tokens": 64
        },
        {
          "tenant": "light",
          "api_key": "bench-light",
          "mode": "closed",
          "concurrency": 1,
          "duration_s": 60,
          "prompt_tokens": 64,
          "max_tokens": 64,
          "warmup_s": 5
        }
      ]
    }
  ]
}
